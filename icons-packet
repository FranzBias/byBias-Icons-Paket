"""
icons-packet — launcher of Icons-Packet 📦🦉

On first run it checks the dependencies. If some are missing, it lists
them and — only after your explicit consent — installs them openly,
using the system graphical authentication (pkexec) or sudo in the terminal.
The script never touches or stores your password: the system handles
it, as for any installation.
"""

import shutil
import subprocess
import sys

from icons_packet_i18n import tr, set_language_from_locale  # no GTK needed

# Dependencies: (readable name, apt package, test)
#   test "py:MOD"      -> importable Python module
#   test "gi:NS:VER"   -> namespace GObject-Introspection
#   test "bin:EXE"     -> executable in PATH
DEPENDENCIES = [
    ("gi",       "python3-gi",       "py:gi"),
    ("Gtk 3.0",  "gir1.2-gtk-3.0",   "gi:Gtk:3.0"),
    ("XApp 1.0", "gir1.2-xapp-1.0",  "gi:XApp:1.0"),
    ("Pillow",   "python3-pil",      "py:PIL"),
    ("wrestool", "icoutils",         "bin:wrestool"),
]


def is_available(test: str) -> bool:
    """Check a single dependency according to its type."""
    try:
        if test.startswith("py:"):
            __import__(test.split(":", 1)[1])
            return True
        if test.startswith("gi:"):
            _, ns, ver = test.split(":")
            import gi
            gi.require_version(ns, ver)
            __import__(f"gi.repository.{ns}", fromlist=[ns])
            return True
        if test.startswith("bin:"):
            return shutil.which(test.split(":", 1)[1]) is not None
    except Exception:
        return False
    return False


def missing_packages():
    """Return the list (without duplicates) of the missing apt packages."""
    seen, out = set(), []
    for _name, pkg, test in DEPENDENCIES:
        if not is_available(test) and pkg not in seen:
            seen.add(pkg)
            out.append(pkg)
    return out


def ask_console(pkgs):
    """Ask for confirmation in the terminal. True if the user agrees."""
    print("\n" + tr("Icons-Packet needs some system packages:"))
    for p in pkgs:
        print(f"  \u2022 {p}")
    print("\n" + tr("They will be installed with:"))
    print(f"  sudo apt install {' '.join(pkgs)}\n")
    try:
        ans = input(tr("Proceed with the installation? [y/N] ")).strip().lower()
    except EOFError:
        return False
    # the "yes" letter of the current language, and always "y"
    return ans in (tr("y"), "y")


def ask_graphical(pkgs):
    """Confirm with a Zenity window, if available.
    True (go ahead) / False (refused) / None (no Zenity)."""
    if not shutil.which("zenity"):
        return None
    text = (tr("Icons-Packet needs some system packages:") + "\n\n"
            + "\n".join(f"\u2022 {p}" for p in pkgs)
            + "\n\n" + tr("Do you want to install them now?"))
    r = subprocess.run(["zenity", "--question", "--width=380",
                        "--title=" + tr("Icons-Packet \u2014 dependencies"),
                        f"--text={text}"])
    return r.returncode == 0


def install(pkgs):
    """Install the packages openly. Prefers pkexec
    (system graphical dialog), then sudo. True if it worked."""
    apt_install = ["apt-get", "install", "-y", *pkgs]

    if shutil.which("pkexec"):
        print(tr("Authentication required (system window)..."))
        subprocess.run(["pkexec", "apt-get", "update"])
        r = subprocess.run(["pkexec", *apt_install])
        return r.returncode == 0

    if shutil.which("sudo"):
        print(tr("Authentication required (sudo)..."))
        subprocess.run(["sudo", "apt-get", "update"])
        r = subprocess.run(["sudo", *apt_install])
        return r.returncode == 0

    print(tr("Neither pkexec nor sudo is available: install manually with:"))
    print(f"  sudo apt install {' '.join(pkgs)}")
    return False


def ensure_dependencies():
    """Check and, with consent, install the missing dependencies.
    True if everything is fine in the end."""
    pkgs = missing_packages()
    if not pkgs:
        return True

    consent = ask_graphical(pkgs)
    if consent is None:
        consent = ask_console(pkgs)
    if not consent:
        print("\n" + tr("Installation cancelled. You can install by hand with:"))
        print(f"  sudo apt install {' '.join(pkgs)}")
        return False

    if not install(pkgs):
        return False

    still = missing_packages()
    if still:
        print("\n" + tr("Some packages are still missing:"))
        print(f"  {' '.join(still)}")
        print(tr("Try installing them by hand, then restart Icons-Packet."))
        return False
    return True


def main():
    set_language_from_locale()
    if not ensure_dependencies():
        sys.exit(1)
    # at this point the graphical dependencies are surely there
    from icons_packet_gui import main as gui_main
    gui_main()


if __name__ == "__main__":
    main()
