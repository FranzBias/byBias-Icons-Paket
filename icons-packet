"""
icons-packet — launcher di Icons-Packet 📦🦉

Alla prima esecuzione controlla le dipendenze. Se ne mancano, le elenca
e — solo dopo il tuo consenso esplicito — le installa in modo trasparente,
usando l'autenticazione grafica di sistema (pkexec) o sudo nel terminale.
Lo script non tocca né memorizza mai la tua password: la gestisce il
sistema, come per qualsiasi installazione.
"""

import shutil
import subprocess
import sys

# Dipendenze: (nome leggibile, pacchetto apt, test)
#   test "py:MOD"      -> modulo Python importabile
#   test "gi:NS:VER"   -> namespace GObject-Introspection
#   test "bin:EXE"     -> eseguibile nel PATH
DEPENDENCIES = [
    ("gi",       "python3-gi",       "py:gi"),
    ("Gtk 3.0",  "gir1.2-gtk-3.0",   "gi:Gtk:3.0"),
    ("XApp 1.0", "gir1.2-xapp-1.0",  "gi:XApp:1.0"),
    ("Pillow",   "python3-pil",      "py:PIL"),
    ("wrestool", "icoutils",         "bin:wrestool"),
]


def is_available(test: str) -> bool:
    """Verifica una singola dipendenza secondo il suo tipo."""
    try:
        if test.startswith("py:"):
            __import__(test.split(":", 1)[1])
            return True
        if test.startswith("gi:"):
            _, ns, ver = test.split(":")
            import gi
            gi.require_version(ns, ver)
            __import__(f"gi.repository.{ns}", fromlist=[ns])
            return True
        if test.startswith("bin:"):
            return shutil.which(test.split(":", 1)[1]) is not None
    except Exception:
        return False
    return False


def missing_packages():
    """Ritorna la lista (senza duplicati) dei pacchetti apt mancanti."""
    seen, out = set(), []
    for _name, pkg, test in DEPENDENCIES:
        if not is_available(test) and pkg not in seen:
            seen.add(pkg)
            out.append(pkg)
    return out


def ask_console(pkgs):
    """Chiede conferma da terminale. True se l'utente acconsente."""
    print("\nIcons-Packet ha bisogno di alcuni pacchetti di sistema:")
    for p in pkgs:
        print(f"  \u2022 {p}")
    print("\nVerranno installati con:")
    print(f"  sudo apt install {' '.join(pkgs)}\n")
    try:
        ans = input("Procedo con l'installazione? [s/N] ").strip().lower()
    except EOFError:
        return False
    return ans in ("s", "y")


def ask_graphical(pkgs):
    """Conferma con finestra Zenity, se disponibile.
    True (procedi) / False (rifiutato) / None (Zenity assente)."""
    if not shutil.which("zenity"):
        return None
    text = ("Icons-Packet ha bisogno di alcuni pacchetti di sistema:\n\n"
            + "\n".join(f"\u2022 {p}" for p in pkgs)
            + "\n\nVuoi installarli ora?")
    r = subprocess.run(["zenity", "--question", "--width=380",
                        "--title=Icons-Packet \u2014 dipendenze",
                        f"--text={text}"])
    return r.returncode == 0


def install(pkgs):
    """Installa i pacchetti in modo trasparente. Preferisce pkexec
    (dialogo grafico di sistema), poi sudo. True se riuscito."""
    apt_install = ["apt-get", "install", "-y", *pkgs]

    if shutil.which("pkexec"):
        print("Autenticazione richiesta (finestra di sistema)...")
        subprocess.run(["pkexec", "apt-get", "update"])
        r = subprocess.run(["pkexec", *apt_install])
        return r.returncode == 0

    if shutil.which("sudo"):
        print("Autenticazione richiesta (sudo)...")
        subprocess.run(["sudo", "apt-get", "update"])
        r = subprocess.run(["sudo", *apt_install])
        return r.returncode == 0

    print("N\u00e9 pkexec n\u00e9 sudo disponibili: installa manualmente con:")
    print(f"  sudo apt install {' '.join(pkgs)}")
    return False


def ensure_dependencies():
    """Controlla e, con consenso, installa le dipendenze mancanti.
    True se alla fine \u00e8 tutto a posto."""
    pkgs = missing_packages()
    if not pkgs:
        return True

    consent = ask_graphical(pkgs)
    if consent is None:
        consent = ask_console(pkgs)
    if not consent:
        print("\nInstallazione annullata. Puoi installare a mano con:")
        print(f"  sudo apt install {' '.join(pkgs)}")
        return False

    if not install(pkgs):
        return False

    still = missing_packages()
    if still:
        print("\nAlcuni pacchetti risultano ancora mancanti:")
        print(f"  {' '.join(still)}")
        print("Prova a installarli a mano e riavvia Icons-Packet.")
        return False
    return True


def main():
    if not ensure_dependencies():
        sys.exit(1)
    # a questo punto le dipendenze grafiche ci sono di sicuro
    from icons_packet_gui import main as gui_main
    gui_main()


if __name__ == "__main__":
    main()
